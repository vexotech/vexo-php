{
    "name": "vexo/vexo-php",
    "description": "Send server-side events and identifies to Vexo from PHP.",
    "type": "library",
    "license": "MIT",
    "keywords": ["vexo", "analytics", "server-side", "events"],
    "homepage": "https://docs.vexo.co/server-side/capture",
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Vexo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vexo\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
